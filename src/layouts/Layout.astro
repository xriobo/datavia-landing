---
// Fuentes autoalojadas: nada se pide a Google Fonts (ni la IP del visitante). Atkinson Hyperlegible, del Braille
// Institute, distingue las letras que más se confunden con baja visión (I l 1, O 0, b d p q).
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/page.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- taste: type software; data-ground sage = el fondo iluminado tras las interfaces. data-theme y data-tone
     los fija el script de abajo antes del primer pintado: oscuro por defecto, claro si el visitante lo eligió. -->
<html lang="es" data-type="software" data-radius="soft" data-ground="sage" data-buttons="solid" data-theme="dark" data-tone="dark" data-motion>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<script is:inline>
			// Antes de pintar nada, para que no destelle el tema contrario. localStorage puede fallar (modo privado).
			(() => {
				let theme = 'dark';
				try { if (localStorage.getItem('datavia-theme') === 'light') theme = 'light'; } catch {}
				document.documentElement.dataset.theme = theme;
				document.documentElement.dataset.tone = theme;
			})();
		</script>
		<meta name="site-kind" content="software" />
		<meta name="page-type" content="software" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#161c1a" />
		<meta name="color-scheme" content="dark light" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="datavia" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL('/og.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- El orden lo fija taste: system, cards, motion, backgrounds, layout y después los tokens. -->
		<link rel="stylesheet" href="/kit/system.css" />
		<link rel="stylesheet" href="/kit/ui/cards.css" />
		<link rel="stylesheet" href="/kit/motion/motion.css" />
		<link rel="stylesheet" href="/kit/backgrounds/backgrounds.css" />
		<link rel="stylesheet" href="/kit/layout/layout.css" />
		<style is:inline>
			:root {
				--p-bg: #161c1a; --p-surface: #1f2725; --p-ink: #e3e2da; --p-muted: #8e948d;
				--p-accent: #9fc7b8; --p-accent-ink: #161c1a; --p-action: #9fc7b8; --p-action-ink: #161c1a;
				--p-inv-bg: #e3e2da; --p-inv-surface: #d3d2cb; --p-inv-ink: #161c1a; --p-inv-muted: #555a55;
				--p-inv-accent: #161c1a; --p-inv-accent-ink: #e3e2da; --p-inv-action: #161c1a; --p-inv-action-ink: #e3e2da;
				--font-display: "Atkinson Hyperlegible Next Variable", system-ui, sans-serif;
				--font-text: "Atkinson Hyperlegible Next Variable", system-ui, sans-serif;
				--font-mono: "Atkinson Hyperlegible Mono Variable", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
				--display-weight: 500;
				/* Atkinson se diseñó con letras bien separadas: apretarlas resta legibilidad */
				--display-tracking: -0.01em;
				--display-tracking-xl: -0.015em;
				--display-stretch: 100%;
				--ly-scale: 1.04;
				color-scheme: dark;
			}
			/* El tema claro: la paleta cool-white-slate que repartió taste para la primera versión */
			:root[data-theme="light"] {
				--p-bg: #f7f9fa; --p-surface: #ecf0f2; --p-ink: #1f3038; --p-muted: #5d6b72;
				--p-accent: #0d7480; --p-accent-ink: #ffffff; --p-action: #0d7480; --p-action-ink: #ffffff;
				--p-inv-bg: #1f3038; --p-inv-surface: #2c3c44; --p-inv-ink: #f7f9fa; --p-inv-muted: #9ea7ab;
				--p-inv-accent: #f7f9fa; --p-inv-accent-ink: #1f3038; --p-inv-action: #f7f9fa; --p-inv-action-ink: #1f3038;
				color-scheme: light;
			}
		</style>
		<script is:inline src="/kit/backgrounds/backgrounds.js"></script>
	</head>
	<body>
		<slot />
		<script is:inline type="module" src="/kit/system.js"></script>
		<script is:inline type="module" src="/kit/motion/motion.js"></script>
		<script is:inline type="module" src="/kit/layout/layout.js"></script>
	</body>
</html>
