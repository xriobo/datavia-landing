---
// Fuentes autoalojadas: nada se pide a Google Fonts (ni la IP del visitante). Atkinson Hyperlegible, del Braille
// Institute, distingue las letras que más se confunden con baja visión (I l 1, O 0, b d p q). Los titulares van en
// Instrument Serif, la letra del logotipo de Grupea: la casa une el texto de Capture con el titular de Grupea.
import '@fontsource/instrument-serif/400.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '@fontsource-variable/atkinson-hyperlegible-mono/wght.css';
import '../styles/page.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- taste: type software; data-ground sage = el fondo iluminado tras las interfaces. data-theme y data-tone
     los fija el script de abajo antes del primer pintado: la elección guardada, si no la del sistema, y si no
     (o sin JavaScript) el claro, que es el que mejor se lee para la mayoría y para quien tiene astigmatismo. -->
<html lang="es" data-type="software" data-radius="soft" data-ground="sage" data-buttons="solid" data-theme="light" data-tone="light" data-motion>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<script is:inline>
			// Antes de pintar nada, para que no destelle el tema contrario. localStorage puede fallar (modo privado).
			(() => {
				let stored = null;
				try { stored = localStorage.getItem('datavia-theme'); } catch {}
				const theme = stored === 'light' || stored === 'dark'
					? stored
					: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = theme;
				document.documentElement.dataset.tone = theme;
			})();
		</script>
		<meta name="site-kind" content="software" />
		<meta name="page-type" content="software" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#f7f5f0" />
		<meta name="color-scheme" content="dark light" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="datavia" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL('/og.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- El orden lo fija taste: system, cards, motion, backgrounds, layout y después los tokens. -->
		<link rel="stylesheet" href="/kit/system.css" />
		<link rel="stylesheet" href="/kit/ui/cards.css" />
		<link rel="stylesheet" href="/kit/motion/motion.css" />
		<link rel="stylesheet" href="/kit/backgrounds/backgrounds.css" />
		<link rel="stylesheet" href="/kit/layout/layout.css" />
		<style is:inline>
			:root {
				/* Tinta cálida sobre negro neutro: la versión nocturna del papel marfil */
				--p-bg: #131518; --p-surface: #1c1f24; --p-ink: #ece8e1; --p-muted: #a0a4ab;
				--p-accent: #a9c1e6; --p-accent-ink: #131518; --p-action: #ece8e1; --p-action-ink: #131518;
				--p-inv-bg: #ece8e1; --p-inv-surface: #ddd8cf; --p-inv-ink: #131518; --p-inv-muted: #54585e;
				--p-inv-accent: #131518; --p-inv-accent-ink: #ece8e1; --p-inv-action: #131518; --p-inv-action-ink: #ece8e1;
				--font-display: "Instrument Serif", Georgia, "Times New Roman", serif;
				--font-text: "Atkinson Hyperlegible Next Variable", system-ui, sans-serif;
				--font-mono: "Atkinson Hyperlegible Mono Variable", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
				--display-weight: 400;
				/* Instrument Serif ya es estrecha: apretarla más la empasta */
				--display-tracking: -0.005em;
				--display-tracking-xl: -0.01em;
				--display-stretch: 100%;
				--ly-scale: 1.04;
				color-scheme: dark;
			}
			/* El tema claro: papel marfil y tinta azul noche, sobrio para una asesoría y cálido como Grupea. La acción
			   es la tinta: el color queda para la identidad de cada producto. */
			:root[data-theme="light"] {
				--p-bg: #f7f5f0; --p-surface: #eeeae2; --p-ink: #1c232c; --p-muted: #575d66;
				--p-accent: #24456e; --p-accent-ink: #ffffff; --p-action: #1c232c; --p-action-ink: #f7f5f0;
				--p-inv-bg: #1c232c; --p-inv-surface: #262e38; --p-inv-ink: #f7f5f0; --p-inv-muted: #a6abb3;
				--p-inv-accent: #f7f5f0; --p-inv-accent-ink: #1c232c; --p-inv-action: #f7f5f0; --p-inv-action-ink: #1c232c;
				color-scheme: light;
			}
		</style>
		<script is:inline src="/kit/backgrounds/backgrounds.js"></script>
	</head>
	<body>
		<slot />
		<script is:inline type="module" src="/kit/system.js"></script>
		<script is:inline type="module" src="/kit/motion/motion.js"></script>
		<script is:inline type="module" src="/kit/layout/layout.js"></script>
	</body>
</html>
