---
// Fuentes autoalojadas: nada se pide a Google Fonts (ni la IP del visitante).
import '@fontsource-variable/instrument-sans/wdth.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/page.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- taste: type software; data-ground sage = el fondo iluminado tras las interfaces. data-tone="dark" desde el
     primer pintado (system.js lo pondría al cargar): así el pie y las bandas nunca destellan en claro. -->
<html lang="es" data-type="software" data-radius="soft" data-ground="sage" data-buttons="solid" data-tone="dark" data-motion>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="site-kind" content="software" />
		<meta name="page-type" content="software" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#161c1a" />
		<meta name="color-scheme" content="dark" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="datavia" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={new URL('/og.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- El orden lo fija taste: system, cards, motion, backgrounds, layout y después los tokens. -->
		<link rel="stylesheet" href="/kit/system.css" />
		<link rel="stylesheet" href="/kit/ui/cards.css" />
		<link rel="stylesheet" href="/kit/motion/motion.css" />
		<link rel="stylesheet" href="/kit/backgrounds/backgrounds.css" />
		<link rel="stylesheet" href="/kit/layout/layout.css" />
		<style is:inline>
			:root {
				--p-bg: #161c1a; --p-surface: #1f2725; --p-ink: #e3e2da; --p-muted: #8e948d;
				--p-accent: #9fc7b8; --p-accent-ink: #161c1a; --p-action: #9fc7b8; --p-action-ink: #161c1a;
				--p-inv-bg: #e3e2da; --p-inv-surface: #d3d2cb; --p-inv-ink: #161c1a; --p-inv-muted: #555a55;
				--p-inv-accent: #161c1a; --p-inv-accent-ink: #e3e2da; --p-inv-action: #161c1a; --p-inv-action-ink: #e3e2da;
				--font-display: "Instrument Sans Variable", "Instrument Sans", system-ui, sans-serif;
				--font-text: "Instrument Sans Variable", "Instrument Sans", system-ui, sans-serif;
				--font-mono: "DM Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
				--display-weight: 500;
				--display-tracking: -0.028em;
				--display-tracking-xl: -0.036em;
				--display-stretch: 96%;
				--ly-scale: 1.04;
			}
		</style>
		<script is:inline src="/kit/backgrounds/backgrounds.js"></script>
	</head>
	<body>
		<slot />
		<script is:inline type="module" src="/kit/system.js"></script>
		<script is:inline type="module" src="/kit/motion/motion.js"></script>
		<script is:inline type="module" src="/kit/layout/layout.js"></script>
	</body>
</html>
