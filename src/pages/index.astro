---
import Layout from '../layouts/Layout.astro';
import HashChain from '../components/HashChain.astro';

// Lo único que cambia de una semana a otra. El 15-nov: launched = true.
// Plan B (sale el amigo invisible de main): name «Amigo invisible», url https://secret-santa.datavia.app/.
const cuentamos = {
	name: 'Cuentamos',
	url: 'https://cuentamos.datavia.app/',
	launched: false,
};

// Los tres productos: el índice de la portada y la cabecera de cada sección salen de aquí
const products = [
	{ id: 'capture', name: 'Capture', mark: '/marks/capture.png', audience: 'Para asesorías y sus empresas' },
	{ id: 'cuentamos', name: cuentamos.name, mark: '/marks/cuentamos.svg', audience: 'Para familias y amigos' },
	{ id: 'custia', name: 'Custia', mark: '/marks/custia.svg', audience: 'Para autónomos y pymes' },
] as const;
const [capture, cuentamosProduct, custia] = products;

const email = 'hola@datavia.app';
const mailto = (subject: string) => `mailto:${email}?subject=${encodeURIComponent(subject)}`;
const contact = mailto('Contacto desde datavia.app');
const mainAction = 'Escribir a datavia';
---

<Layout
	title="datavia: software para asesorías, empresas y familias"
	description="Capture recoge facturas y altas desde el móvil, Custia prepara la facturación VERI*FACTU y Cuentamos organiza regalos y gastos con tu gente."
>
	<!-- type: software
	     deal: hero collage, nav nav-centre (nav-cards dealt; no photographs), close close-type, footer footer-dark,
	     rhythm surface-pairs, buttons tonal, mark wordmark, ground sky (lit, CSS)
	     moments: none (landing-studio mode C: taste motion layer only) -->
	<header class="nav nav--centre">
		<div class="wrap nav__bar">
			<a class="skip" href="#capture">Saltar al contenido</a>
			<a class="nav__logo" href="#top">datavia</a>
			<nav class="nav__links" aria-label="Principal">
				<div class="nav__item"><a class="nav__link" href="#capture">Capture</a></div>
				<div class="nav__item"><a class="nav__link" href="#cuentamos">{cuentamos.name}</a></div>
				<div class="nav__item"><a class="nav__link" href="#custia">Custia</a></div>
				<div class="nav__item"><a class="nav__link" href="#reglas">Reglas</a></div>
			</nav>
			<div class="nav__actions">
				<button class="btn btn--secondary theme-toggle" type="button" data-theme-toggle aria-label="Cambiar a tema claro">
					<svg class="theme-toggle__sun" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.5"></circle><path d="M10 1.5v2.5M10 16v2.5M1.5 10H4M16 10h2.5M4 4l1.8 1.8M14.2 14.2 16 16M4 16l1.8-1.8M14.2 5.8 16 4"></path></svg>
					<svg class="theme-toggle__moon" viewBox="0 0 20 20" aria-hidden="true"><path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7z"></path></svg>
				</button>
				<a class="btn btn--primary" href={contact}>{mainAction}</a>
			</div>
			<button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menú">
				<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
			</button>
		</div>
	</header>

	<main id="top">
		<section class="hero hero--collage" aria-labelledby="hero-h">
			<div class="wrap">
				<div class="hero-text grid hero__grid">
					<div class="hero__text span-6">
						<h1 id="hero-h">Software para asesorías, empresas y familias</h1>
						<p class="hero__lead">
							Capture recoge facturas y altas desde el móvil, Custia prepara la facturación VERI*FACTU
							y {cuentamos.name} organiza regalos y gastos con tu gente.
						</p>
						<div class="btn-row">
							<a class="btn btn--primary" href={contact}>{mainAction}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
						</div>
						<p class="hero__proof">
							{cuentamos.launched
								? <>Nuevo: <strong>{cuentamos.name}</strong>, gratis y sin crear cuenta</>
								: <>{cuentamos.name} abre el <strong>15 de noviembre de 2026</strong></>}
						</p>
						<ul class="products" aria-label="Las tres aplicaciones de datavia">
							{products.map((p) => (
								<li>
									<a class="product" href={`#${p.id}`}>
										<img src={p.mark} alt="" width="40" height="40" />
										<span class="product__name">{p.name}</span>
										<span class="product__for">{p.audience}</span>
									</a>
								</li>
							))}
						</ul>
					</div>

					<div class="hero__art span-6 start-7">
						<div class="ly-piece ly-piece--main d-win ui" role="img" aria-label="Capture: un alta de trabajador con los datos leídos del DNI y de la tarjeta sanitaria">
							<div class="d-win__bar"><span class="d-win__dots"><i></i><i></i><i></i></span><span>Capture · Altas y bajas</span></div>
							<div class="d-win__body">
								<div class="d-side">
									<span><i></i>Facturas</span>
									<span class="is-on"><i></i>Altas y bajas</span>
									<span><i></i>Histórico</span>
									<span class="d-side__label">Destinatario</span>
									<span><i></i>Asesoría laboral</span>
								</div>
								<div class="d-main">
									<div class="d-main__head"><h4>Alta de trabajador</h4><span class="d-btn">Revisar el alta</span></div>
									<div class="cap-docs">
										<span class="cap-doc"><span class="idcard"></span><small>DNI, anverso</small></span>
										<span class="cap-doc"><span class="idcard idcard--back"></span><small>DNI, reverso</small></span>
										<span class="cap-doc"><span class="idcard idcard--health"></span><small>Tarjeta sanitaria</small></span>
									</div>
									<div class="cap-fields">
										<div class="cap-field"><small>Nombre y apellidos</small><b>Lucía Martín Sanz</b><span class="ok">Leído del documento</span></div>
										<div class="cap-field"><small>DNI o NIE</small><b>12345678Z</b><span class="ok">NIF válido</span></div>
										<div class="cap-field"><small>Número de la Seguridad Social</small><b>28/12345678/40</b><span class="ok">Leído de la tarjeta</span></div>
										<div class="cap-field is-focus"><small>Domicilio completo</small><b>Calle del Pez, Madrid</b><span class="ok ok--ask">Confírmalo</span></div>
									</div>
								</div>
							</div>
						</div>
						<div class="ly-piece ly-piece--note d-card" role="img" aria-label={`${cuentamos.name}: un bote para un regalo, pagado entre ocho personas`} data-ly-steps="700">
							<div class="d-card__row"><h5>Bote · bici para Leo</h5><span class="d-chip" data-step data-step-at="4">Comprado</span></div>
							<div class="d-note__line" data-step><i>✓</i><span><b>8 personas</b> se apuntan</span></div>
							<div class="d-note__line" data-step><i>✓</i><span><b>8 de 8</b> han pagado su parte</span></div>
							<div class="d-note__line" data-step><i>✓</i><span>Comprada por <b>176,00 €</b></span></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="capture" aria-labelledby="capture-h">
			<div class="wrap">
				<div class="grid grid--top fill">
					<div class="span-6 split-col">
						<h2 id="capture-h">Capture. <span class="muted">Facturas y altas de trabajadores desde el móvil.</span></h2>
						<p class="t-lead">
							Las empresas de una asesoría mandan facturas, altas y bajas con una foto. Capture lee el DNI y
							la tarjeta sanitaria, valida el NIF y lo entrega al correo o al programa de la asesoría.
						</p>
						<div class="btn-row">
							<a class="btn btn--secondary" href={mailto('Demo de Capture')}>Pedir una demo de Capture</a>
						</div>
						<p class="status"><b>{capture.audience}</b> · En producción con su primera asesoría.</p>
					</div>
					<div class="frame frame--fill lit span-6 start-7" role="img" aria-label="Capture en el móvil con el alta lista para enviar">
						<div class="phone ui ui-mock" aria-hidden="true">
							<div class="phone__bar"><span>Capture</span><span class="phone__who">Talleres Ribera</span></div>
							<p class="phone__title">Revisa el alta</p>
							<dl class="review">
								<div><dt>Empresa</dt><dd>Talleres Ribera, S. L.</dd></div>
								<div><dt>Trabajador</dt><dd>Lucía Martín Sanz</dd></div>
								<div><dt>DNI o NIE</dt><dd>12345678Z</dd></div>
								<div><dt>Fecha de alta</dt><dd>16 de noviembre de 2026</dd></div>
								<div><dt>Tipo de contrato</dt><dd>Indefinido</dd></div>
								<div><dt>Puesto de trabajo</dt><dd>Mecánica</dd></div>
							</dl>
							<p class="phone__label">Documentos</p>
							<div class="cap-docs cap-docs--phone">
								<span class="idcard"></span><span class="idcard idcard--back"></span><span class="idcard idcard--health"></span>
							</div>
							<div class="phone__actions"><span class="ph-btn ph-btn--ghost">Corregir</span><span class="ph-btn">Enviar el alta</span></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="cuentamos" aria-labelledby="cuentamos-h">
			<div class="wrap">
				<div class="section-head">
					<h2 id="cuentamos-h">{cuentamos.name}. <span class="muted">Regalos, botes y gastos con tu gente.</span></h2>
					<p>
						Listas de deseos, botes para regalos en grupo, gastos del piso o del viaje y amigo invisible. Se
						entra con un enlace, sin crear cuenta, y es gratis.
					</p>
					<p class="status">
						<b>{cuentamosProduct.audience}</b> · {cuentamos.launched ? 'Ya está abierto' : 'Abre el 15 de noviembre de 2026'}
					</p>
					{cuentamos.launched && <div class="btn-row"><a class="btn btn--secondary" href={cuentamos.url}>Abrir {cuentamos.name}</a></div>}
				</div>
				<div class="grid cards-3 fill">
					<article class="card m-nolift span-4">
						<h3>Reserva un regalo de la lista</h3>
						<p>Quien tiene la lista no ve quién regala qué, así que la sorpresa aguanta.</p>
						<div class="panel lit">
							<div class="stage stage--fade-b"><div class="at-rise fit" style="--fit-max:320px;--ax:max(24px, 50% - 160px);--ay:32px;--ay-sm:20px">
								<div class="frag ui ui-mock" aria-hidden="true">
									<p class="frag__head">Lista de Ana · cumpleaños</p>
									<div class="wish"><div><b>Auriculares inalámbricos</b><small>59,00 €</small></div><span class="ph-btn ph-btn--sm">Lo regalo yo</span></div>
									<div class="wish"><div><b>Libro de cocina de cuchara</b><small>24,90 €</small></div><span class="wish__taken">Ya lo regala alguien</span></div>
									<div class="wish"><div><b>Bicicleta de paseo</b><small>176,00 €</small></div><span class="ph-btn ph-btn--sm ph-btn--ghost">Regaladlo entre varios</span></div>
								</div>
							</div></div>
						</div>
					</article>
					<article class="card m-nolift span-4">
						<h3>Junta el dinero de un regalo</h3>
						<p>Cada uno se apunta al bote, marca que ha pagado y quien recoge lo confirma.</p>
						<div class="panel lit">
							<div class="stage stage--fade-b"><div class="at-rise fit" style="--fit-max:320px;--ax:max(24px, 50% - 160px);--ay:32px;--ay-sm:20px">
								<div class="frag ui ui-mock" aria-hidden="true">
									<p class="frag__head">Bote · bici para Leo</p>
									<p class="pot__sum"><b>132,00 €</b> de 176,00 €</p>
									<div class="pot__bar"><i style="--v: 75%"></i></div>
									<div class="wish"><div><b>Marta</b><small>22,00 €</small></div><span class="wish__state">Recibido</span></div>
									<div class="wish"><div><b>Iván</b><small>22,00 €</small></div><span class="wish__state">Ya he pagado</span></div>
									<div class="wish"><div><b>Tú</b><small>22,00 €</small></div><span class="ph-btn ph-btn--sm">Me apunto</span></div>
								</div>
							</div></div>
						</div>
					</article>
					<article class="card m-nolift span-4">
						<h3>Sortea el amigo invisible</h3>
						<p>Hasta 200 personas, con exclusiones y niños a cargo de un adulto.</p>
						<div class="panel lit">
							<div class="stage stage--fade-b"><div class="at-rise fit" style="--fit-max:320px;--ax:max(24px, 50% - 160px);--ay:32px;--ay-sm:20px">
								<div class="frag ui ui-mock" aria-hidden="true">
									<p class="frag__head">Familia García · 12 personas</p>
									<div class="wish"><div><b>Sorteo hecho</b><small>Nadie se toca a sí mismo</small></div><span class="wish__state">Comprobado</span></div>
									<div class="wish"><div><b>Leo y Carla</b><small>A cargo de mamá</small></div><span class="wish__state">Niños</span></div>
									<div class="wish"><div><b>Enlaces personales</b><small>Uno para cada uno</small></div><span class="ph-btn ph-btn--sm">Enviar por WhatsApp</span></div>
								</div>
							</div></div>
						</div>
					</article>
				</div>
			</div>
		</section>

		<section class="section ground-surface" id="custia" aria-labelledby="custia-h">
			<div class="wrap">
				<div class="grid grid--top fill">
					<div class="span-6 split-col">
						<h2 id="custia-h">Custia. <span class="muted">Facturación VERI*FACTU con huella encadenada.</span></h2>
						<p class="t-lead">
							Cada factura guarda la huella SHA-256 de la anterior, contrastada con los vectores de la AEAT.
							Obligatorio desde el 1 de enero de 2027 en sociedades y el 1 de julio en autónomos.
						</p>
						<div class="btn-row">
							<a class="btn btn--secondary" href={mailto('Aviso de Custia')}>Pedir aviso de Custia</a>
						</div>
						<p class="status"><b>{custia.audience}</b> · Motor terminado; el periodo de pruebas aún no está abierto.</p>
					</div>
					<div class="frame frame--fill lit span-6 start-7">
						<HashChain />
					</div>
				</div>
			</div>
		</section>

		<section class="section ground-surface" id="reglas" aria-labelledby="reglas-h">
			<div class="wrap">
				<div class="section-head">
					<h2 id="reglas-h">Las tres reglas de datavia</h2>
					<p>Lo que pedimos a todo lo que sale de datavia, y dónde se ve en cada producto.</p>
				</div>
				<div class="grid cards-3 fill">
					<article class="card m-nolift span-4">
						<h3>Comprueba antes de guardar</h3>
						<p>Capture valida el NIF, {cuentamos.name} verifica el sorteo y Custia cada huella.</p>
						<div class="panel lit">
							<div class="stage stage--fade-b"><div class="at-rise fit" style="--fit-max:300px;--ax:max(24px, 50% - 150px);--ay:40px;--ay-sm:20px">
								<div class="frag ui ui-mock" aria-hidden="true">
									<p class="frag__label">DNI o NIE</p>
									<p class="frag__input is-bad">12345678A</p>
									<p class="frag__error">No es un NIF válido.</p>
									<p class="frag__label">DNI o NIE</p>
									<p class="frag__input">12345678Z<span class="ok">NIF válido</span></p>
								</div>
							</div></div>
						</div>
					</article>
					<article class="card m-nolift span-4">
						<h3>Funciona sin descargar nada</h3>
						<p>Capture y {cuentamos.name} se abren con un enlace y se instalan desde el navegador.</p>
						<div class="panel lit">
							<div class="stage stage--fade-b"><div class="at-rise fit" style="--fit-max:300px;--ax:max(24px, 50% - 150px);--ay:40px;--ay-sm:20px">
								<div class="frag ui ui-mock" aria-hidden="true">
									<p class="frag__head">¿Instalar la aplicación?</p>
									<div class="install"><span class="install__icon">C</span><div><b>{cuentamos.name}</b><small>{new URL(cuentamos.url).host}</small></div></div>
									<div class="phone__actions"><span class="ph-btn ph-btn--ghost">Ahora no</span><span class="ph-btn">Instalar</span></div>
								</div>
							</div></div>
						</div>
					</article>
					<article class="card m-nolift span-4">
						<h3>Guarda solo lo necesario</h3>
						<p>Capture borra los adjuntos al entregarlos y {cuentamos.name} solo usa cookies técnicas.</p>
						<div class="panel lit">
							<div class="stage stage--fade-b"><div class="at-rise fit" style="--fit-max:300px;--ax:max(24px, 50% - 150px);--ay:40px;--ay-sm:20px">
								<div class="frag ui ui-mock" aria-hidden="true">
									<p class="frag__head">Histórico en este móvil</p>
									<div class="wish"><div><b>Alta · Lucía Martín</b><small>9 de noviembre</small></div><span class="wish__state">Enviado</span></div>
									<div class="wish"><div><b>Facturas · 3 documentos</b><small>8 de noviembre</small></div><span class="wish__state">Enviado</span></div>
									<p class="frag__note">Sin adjuntos ni NIF guardados. Caduca a los 90 días.</p>
								</div>
							</div></div>
						</div>
					</article>
				</div>
			</div>
		</section>
	</main>

	<footer class="footer closing footer--dark ground-inverse" id="contact" aria-labelledby="close-h">
		<div class="wrap">
			<div class="closing__cta close--type">
				<div class="section-head">
					<h2 id="close-h">Escribe a datavia</h2>
					<p>Una demo de Capture, el aviso de Custia o cualquier duda sobre {cuentamos.name}: {email}</p>
				</div>
				<a class="btn btn--primary btn--xl btn--wide" href={contact}>{mainAction}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
			</div>
			<div class="closing__links">
				<div class="grid">
					<div class="span-6 stack-4">
						<a class="nav__logo" href="#top">datavia</a>
						<p class="footer__lede">Software para asesorías, empresas y familias, hecho en España.</p>
					</div>
					<div class="span-3 footer__col">
						<h4>Aplicaciones</h4>
						<ul>
							<li><a href="#capture">Capture</a></li>
							<li><a href="#cuentamos">{cuentamos.name}</a></li>
							<li><a href="#custia">Custia</a></li>
						</ul>
					</div>
					<div class="span-3 footer__col">
						<h4>datavia</h4>
						<ul>
							<li><a href="#reglas">Reglas</a></li>
							<li><a href={contact}>{email}</a></li>
						</ul>
					</div>
				</div>
				<div class="footer__legal">
					<span>&copy; {new Date().getFullYear()} datavia</span>
					<button class="theme-link" type="button" data-theme-toggle data-theme-label>Tema claro</button>
				</div>
			</div>
		</div>
	</footer>

	<script>
		// El tema lo elige un clic y se recuerda en este dispositivo; el script del <head> lo aplica antes de pintar.
		const root = document.documentElement;
		const toggles = document.querySelectorAll<HTMLElement>('[data-theme-toggle]');
		const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

		function sync() {
			const target = root.dataset.theme === 'light' ? 'oscuro' : 'claro';
			for (const el of toggles) {
				el.setAttribute('aria-label', `Cambiar a tema ${target}`);
				if (el.hasAttribute('data-theme-label')) el.textContent = `Tema ${target}`;
			}
			themeColor?.setAttribute('content', getComputedStyle(root).getPropertyValue('--p-bg').trim());
		}

		for (const el of toggles) {
			el.addEventListener('click', () => {
				const next = root.dataset.theme === 'light' ? 'dark' : 'light';
				root.dataset.theme = next;
				root.dataset.tone = next;
				try {
					localStorage.setItem('datavia-theme', next);
				} catch {
					// Sin almacenamiento (modo privado) el tema dura lo que la visita.
				}
				sync();
			});
		}

		sync();
	</script>
</Layout>
