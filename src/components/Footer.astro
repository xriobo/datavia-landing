---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p class="mono">© {year} datavia</p>
		<a href="https://capture.datavia.app/" class="site-footer__link">capture.datavia.app ↗</a>
	</div>
</footer>

<style>
	.site-footer {
		padding-block: var(--space-l);
		border-top: 1px solid color-mix(in srgb, var(--text-hi) 8%, transparent);
	}

	.site-footer__inner {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-s);
		align-items: center;
		justify-content: space-between;
		font-size: var(--step--1);
		color: var(--text-lo);
	}

	.site-footer__link {
		text-decoration: none;
		font-family: var(--font-mono);
		color: var(--text-lo);
		transition: color 0.2s var(--ease);
	}

	.site-footer__link:hover {
		color: var(--seal);
	}
</style>
