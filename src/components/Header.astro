---
const captureUrl = 'https://capture.datavia.app/';
---

<header class="site-header">
	<div class="container site-header__inner">
		<a href="/" class="site-header__mark">datavia</a>
		<a href={captureUrl} class="site-header__cta">
			Abrir Capture
			<span aria-hidden="true">↗</span>
		</a>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		padding-block: var(--space-s);
		background: color-mix(in srgb, var(--ink) 78%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid color-mix(in srgb, var(--text-hi) 8%, transparent);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-s);
	}

	.site-header__mark {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: var(--step-1);
		text-decoration: none;
		letter-spacing: -0.01em;
	}

	.site-header__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--text-hi);
		border: 1px solid color-mix(in srgb, var(--text-hi) 25%, transparent);
		border-radius: 999px;
		padding: 0.5em 1.1em;
		transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
	}

	.site-header__cta:hover {
		border-color: var(--seal);
		color: var(--seal);
	}
</style>
