---
import HashChainDemo from './HashChainDemo.astro';
import Countdown from './Countdown.astro';

const captureUrl = 'https://capture.datavia.app/';
---

<section class="journey" id="recorrido">
	<div class="container journey__intro">
		<p class="eyebrow journey__eyebrow" data-reveal>El recorrido de un documento</p>
		<h2 class="journey__title" data-reveal>De la foto en el móvil al sello que ya no se toca</h2>
	</div>

	<div class="track" data-track>
		<div class="container track__stations">
			<div class="track__fill" data-track-fill aria-hidden="true"></div>

			<article class="station" data-reveal>
				<span class="station__dot station__dot--seal" aria-hidden="true"></span>
				<div class="station__card">
					<span class="pill pill--live">En producción</span>
					<h3 class="station__name">Capture</h3>
					<p class="station__desc">
						La PWA con la que las empresas cliente de una asesoría mandan facturas y altas y
						bajas de trabajadores desde el móvil. Revisión antes de enviar, borrador si la cámara
						corta el formulario a mitad, miniatura de cada documento — nada se manda a ciegas.
					</p>
					<a class="button button--primary" href={captureUrl}>
						Abrir Capture
						<span aria-hidden="true">↗</span>
					</a>
				</div>
			</article>

			<article class="station station--ocr" data-reveal>
				<span class="station__dot station__dot--slate" aria-hidden="true"></span>
				<div class="station__card station__card--ghost">
					<span class="pill pill--planned">Planeado</span>
					<h3 class="station__name">OCR</h3>
					<p class="station__desc">
						Leer la factura en vez de teclearla. Hoy el documento atraviesa este tramo sin que
						nada lo lea todavía — es la siguiente estación de la vía, no la actual.
					</p>
					<div class="station__scan" aria-hidden="true">
						<span class="station__scan-track"></span>
						<span class="station__scan-dot"></span>
					</div>
				</div>
			</article>

			<article class="station station--custia" data-reveal>
				<span class="station__dot station__dot--brass" aria-hidden="true"></span>
				<div class="station__card">
					<span class="pill pill--advanced">
						<svg width="11" height="11" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M6 11V8a6 6 0 1 1 12 0v3M5 11h14v9a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-9z"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						Fase 1 completa · pruebas sin abrir
					</span>
					<h3 class="station__name">Custia</h3>
					<p class="station__desc">
						El sistema de facturación verificable: VERI*FACTU o conservación local, con cadena de
						huellas SHA-256 ya contrastada contra los vectores oficiales de la AEAT y los XSD del
						RRSIF. Falta abrir el periodo de pruebas, no el motor — pruébalo abajo:
					</p>
					<HashChainDemo />
					<Countdown />
				</div>
			</article>
		</div>
	</div>
</section>

<style>
	.journey {
		padding-block: var(--space-xl) var(--space-xxl);
	}

	.journey__intro {
		max-width: 34rem;
		margin-bottom: var(--space-xl);
	}

	.journey__eyebrow {
		color: var(--slate);
		margin-bottom: var(--space-xs);
	}

	.journey__title {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-3);
		letter-spacing: -0.01em;
	}

	.track__stations {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.track__fill {
		position: absolute;
		left: 0.5rem;
		top: 0.65rem;
		width: 2px;
		height: 0%;
		background: linear-gradient(var(--seal), var(--brass));
		z-index: 1;
	}

	.station {
		position: relative;
		padding-left: 2.75rem;
	}

	.station::before {
		content: '';
		position: absolute;
		left: 0.5rem;
		top: 0.65rem;
		bottom: calc(-1 * var(--space-xl));
		width: 2px;
		background: color-mix(in srgb, var(--text-hi) 12%, transparent);
	}

	.station:last-child::before {
		display: none;
	}

	.station__dot {
		position: absolute;
		left: 0;
		top: 0.15rem;
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 50%;
		background: var(--ink);
		z-index: 2;
	}

	.station__dot--seal {
		box-shadow: 0 0 0 2px var(--seal);
	}

	.station__dot--slate {
		box-shadow: 0 0 0 2px var(--slate);
	}

	.station__dot--brass {
		box-shadow: 0 0 0 2px var(--brass);
	}

	.station__card {
		background: var(--ink-raised);
		border: 1px solid color-mix(in srgb, var(--text-hi) 10%, transparent);
		border-radius: var(--radius);
		padding: var(--space-l);
		max-width: 40rem;
	}

	.station__card--ghost {
		background: transparent;
		border-style: dashed;
		border-color: color-mix(in srgb, var(--slate) 45%, transparent);
	}

	.station__name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: var(--step-2);
		margin-top: var(--space-s);
	}

	.station__desc {
		margin-top: var(--space-s);
		color: var(--text-lo);
		max-width: 34rem;
	}

	.station__card > .button {
		margin-top: var(--space-m);
	}

	.station__scan {
		position: relative;
		margin-top: var(--space-m);
		height: 1.4rem;
	}

	.station__scan-track {
		position: absolute;
		inset: 50% 0 auto;
		height: 1px;
		background-image: repeating-linear-gradient(
			to right,
			color-mix(in srgb, var(--slate) 55%, transparent) 0 6px,
			transparent 6px 12px
		);
	}

	.station__scan-dot {
		position: absolute;
		top: 50%;
		left: 0;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--slate);
		transform: translate(-50%, -50%);
		opacity: 0;
	}

	.station--ocr.is-visible .station__scan-dot {
		animation: scan-pass 2s var(--ease) 0.5s both;
	}

	@keyframes scan-pass {
		0% {
			left: 0%;
			opacity: 0;
		}
		12% {
			opacity: 1;
		}
		88% {
			opacity: 1;
		}
		100% {
			left: 100%;
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.station--ocr.is-visible .station__scan-dot {
			animation: none;
			opacity: 0.6;
			left: 50%;
		}
	}

	@media (max-width: 30rem) {
		.station__card {
			padding: var(--space-m);
		}
	}
</style>

<script>
	const track = document.querySelector<HTMLElement>('[data-track]');
	const fill = document.querySelector<HTMLElement>('[data-track-fill]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (track && fill) {
		if (prefersReducedMotion) {
			fill.style.height = '100%';
		} else {
			let ticking = false;

			const updateProgress = () => {
				const rect = track.getBoundingClientRect();
				const viewportHeight = window.innerHeight;
				const total = rect.height + viewportHeight;
				const scrolled = viewportHeight - rect.top;
				const progress = Math.min(1, Math.max(0, scrolled / total));
				fill.style.height = `${progress * 100}%`;
				ticking = false;
			};

			const onScroll = () => {
				if (!ticking) {
					requestAnimationFrame(updateProgress);
					ticking = true;
				}
			};

			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll);
			updateProgress();
		}
	}
</script>
